{
	"name": "codama-nodes-from-pina",
	"version": "0.8.0",
	"description": "Helpers for converting Pina IDLs into Codama RootNodes",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pina-rs/pina.git",
		"directory": "packages/nodes-from-pina"
	},
	"type": "commonjs",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"react-native": "./dist/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		"types": "./dist/types/index.d.ts",
		"import": "./dist/index.mjs",
		"require": "./dist/index.js"
	},
	"files": [
		"./dist"
	],
	"scripts": {
		"build": "rimraf dist && tsup && tsc -p ./tsconfig.declarations.json",
		"dev": "vitest --project node",
		"test": "pnpm test:types && pnpm test:unit",
		"test:types": "tsc --noEmit",
		"test:unit": "vitest run"
	},
	"dependencies": {
		"codama": "^1.10.0"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"typescript": "^6.0.2",
		"vitest": "^4.1.1"
	}
}
