{
	"name": "@pina-rs/codama-renderer-cpi",
	"version": "0.13.0",
	"description": "Codama visitor that renders standalone Pina CPI crates",
	"license": "Apache-2.0",
	"homepage": "https://pina.rs",
	"bugs": {
		"url": "https://github.com/pina-rs/pina/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pina-rs/pina.git",
		"directory": "packages/codama-renderer-cpi"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		"types": "./dist/types/index.d.ts",
		"import": "./dist/index.js"
	},
	"files": [
		"./dist",
		"./README.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "rimraf dist && tsup && tsc -p ./tsconfig.declarations.json",
		"test": "pnpm test:types && pnpm test:unit",
		"test:types": "tsc --noEmit",
		"test:unit": "vitest run"
	},
	"dependencies": {
		"@pina-rs/cli": "^0.13.0",
		"codama": "^1.10.2"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=18"
	}
}
