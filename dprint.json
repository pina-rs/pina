{
	"incremental": true,
	"indentWidth": 2,
	"useTabs": true,
	"exec": {
		"commands": [
			{
				"command": "rustfmt --unstable-features --edition 2024",
				"exts": [
					"rs"
				]
			},
			{
				"command": "nixfmt",
				"exts": [
					"nix"
				]
			},
			{
				"command": "shfmt --filename {{file_path}} -i 0",
				"exts": [
					"sh",
					"bash"
				]
			}
		]
	},
	"typescript": {
		"deno": true,
		"useTabs": true,
		"module.sortExportDeclarations": "caseInsensitive",
		"module.sortImportDeclarations": "caseInsensitive"
	},
	"json": {
		"deno": true,
		"useTabs": true
	},
	"toml": {
		"useTabs": true,
		"indentWidth": 2,
		"cargo.applyConventions": true
	},
	"markdown": {
		"deno": true,
		"textWrap": "never"
	},
	"excludes": [
		"**/dist",
		".devenv/**",
		"worktrees/**",
		"**/fixtures",
		"**/snapshots",
		"tests/expand/*.expanded.rs",
		"**/target",
		"**/node_modules",
		"**/pnpm-lock.yaml",
		"api-docs.t.md",
		"templates/**/*.t.md",
		".bin/",
		".local-cache/",
		"**/dist/**",
		"**/pkg/",
		"**/abi_layout.rs",
		"**/*.schema.json"
	],
	"plugins": [
		"npm:@dprint/typescript@0.96.1",
		"npm:@dprint/json@0.25.0",
		"npm:@dprint/markdown@0.24.0",
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
		"npm:@dprint/toml@0.8.0",
		"npm:dprint-plugin-yaml@0.6.0"
	]
}
