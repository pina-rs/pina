{
	"name": "@pina-rs/workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"generate": "cargo run -p pina_cli -- codama generate --npx node",
		"check:js": "tsc --noEmit -p codama/tsconfig.json",
		"build:codama-nodes": "pnpm --filter @pina-rs/codama-nodes build",
		"check:npm-packages": "node scripts/npm/check-packages.mjs",
		"test:codama-nodes": "pnpm --filter @pina-rs/codama-nodes test",
		"test:idls": "pnpm --filter pina-codama-idl-tests test",
		"test:npm-packages": "node --test scripts/npm/tests/*.test.mjs",
		"test:quasar-svm": "pnpm --filter pina-quasar-svm-e2e test",
		"test": "pnpm run generate && pnpm run check:js"
	},
	"dependencies": {
		"@codama/renderers-js": "^2.3.1",
		"codama": "^1.10.1",
		"codama-renderers-dart": "0.5.1"
	},
	"devDependencies": {
		"@solana/surfpool": "^1.5.0",
		"@solana/kit": "^6.10.0",
		"@solana/program-client-core": "^6.10.0",
		"@types/node": "^26.2.0",
		"typescript": "^7.0.2"
	}
}
