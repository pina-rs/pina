//! This code was AUTOGENERATED by `pina_codama_renderer`.
//! Please DO NOT EDIT THIS FILE directly.
//! Regenerate it from Codama IDLs instead.
#![allow(
	clippy::doc_lazy_continuation,
	clippy::empty_line_after_doc_comments,
	clippy::new_without_default,
	clippy::too_many_arguments
)]

pub const MAYBE_DISCRIMINATOR: u8 = 9u8;

/// Accounts.
#[derive(Clone, Debug)]
pub struct Maybe {
	pub optional_signer: Option<(solana_pubkey::Pubkey, bool)>,
	pub required_account: solana_pubkey::Pubkey,
}

impl Maybe {
	pub fn new(required_account: solana_pubkey::Pubkey) -> Self {
		Self {
			optional_signer: None,
			required_account,
		}
	}

	pub fn instruction(&self, data: MaybeInstructionData) -> solana_instruction::Instruction {
		self.instruction_with_remaining_accounts(data, &[])
	}

	#[allow(clippy::arithmetic_side_effects)]
	pub fn instruction_with_remaining_accounts(
		&self,
		data: MaybeInstructionData,
		remaining_accounts: &[solana_instruction::AccountMeta],
	) -> solana_instruction::Instruction {
		let mut accounts = Vec::with_capacity(2 + remaining_accounts.len());
		if let Some((optional_signer, signer)) = self.optional_signer {
			accounts.push(solana_instruction::AccountMeta::new_readonly(optional_signer, signer));
		}
		else {
			accounts.push(solana_instruction::AccountMeta::new_readonly(crate::OPTIONAL_PROGRAM_ID, false));
		}
		accounts.push(solana_instruction::AccountMeta::new_readonly(self.required_account, false));
		accounts.extend_from_slice(remaining_accounts);
		let mut instruction_data = vec![0u8; core::mem::size_of_val(&data)];
		pina::PinaSerialize::write_bytes(&data, &mut instruction_data);

		solana_instruction::Instruction {
			program_id: crate::OPTIONAL_PROGRAM_ID,
			accounts,
			data: instruction_data,
		}
	}
}

#[repr(C)]
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct MaybeInstructionData {
	pub discriminator: u8,
}

impl MaybeInstructionData {
	pub const fn new() -> Self {
		Self {
			discriminator: MAYBE_DISCRIMINATOR,
		}
	}
}

impl pina::PinaSerialize for MaybeInstructionData {
	fn write_bytes(&self, output: &mut [u8]) {
		assert_eq!(output.len(), core::mem::size_of::<Self>());
		output.fill(0);
		let mut offset = 0usize;
		let field_size = core::mem::size_of::<u8>();
		pina::PinaSerialize::write_bytes(&self.discriminator, &mut output[offset..offset + field_size]);
		offset += field_size;
		debug_assert_eq!(offset, output.len());
	}
}
