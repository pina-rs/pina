	pub fn from_bytes_mut(data: &mut [u8]) -> Result<&mut Self, solana_program_error::ProgramError> {
		let account = pina::pod_from_bytes_mut::<Self>(data)
			.map_err(|_| solana_program_error::ProgramError::InvalidAccountData)?;
