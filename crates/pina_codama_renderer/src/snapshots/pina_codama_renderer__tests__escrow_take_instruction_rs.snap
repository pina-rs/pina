use pina::zeropod;

pub const TAKE_DISCRIMINATOR: u8 = 2u8;

/// Accounts.
#[derive(Clone, Debug)]
pub struct Take {
	pub taker: solana_pubkey::Pubkey,
	pub mint_a: solana_pubkey::Pubkey,
	pub mint_b: solana_pubkey::Pubkey,
