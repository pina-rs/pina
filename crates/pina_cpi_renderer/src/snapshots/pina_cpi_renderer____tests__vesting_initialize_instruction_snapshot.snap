---
source: crates/pina_cpi_renderer/src/__tests.rs
expression: "render_fixture_instruction(\"vesting_program\", \"initialize\")"
---
use pina::AccountView;
use pina::CpiContext;
use pina::CpiHandle;
use pina::ProgramError;
use pina::ProgramResult;
use pina::Signer;
use pina::ToCpiAccounts;

use crate::ProgramAccount;

/// Accounts required by the `initialize` instruction.
#[derive(Clone, Copy, Debug)]
pub struct InitializeAccounts<'a> {
	/// writable, must sign.
	pub admin: CpiHandle<'a>,
	pub beneficiary: CpiHandle<'a>,
	pub mint: CpiHandle<'a>,
	/// writable.
	pub vesting_state: CpiHandle<'a>,
	/// writable.
	pub vault: CpiHandle<'a>,
	pub associated_token_program: CpiHandle<'a>,
	pub system_program: CpiHandle<'a>,
	pub token_program: CpiHandle<'a>,
}

impl<'a> InitializeAccounts<'a> {
	/// Validates writable privileges and builds the CPI account set.
	pub fn new(
		admin: &'a AccountView,
		beneficiary: &'a AccountView,
		mint: &'a AccountView,
		vesting_state: &'a AccountView,
		vault: &'a AccountView,
		associated_token_program: &'a AccountView,
		system_program: &'a AccountView,
		token_program: &'a AccountView,
	) -> Result<Self, ProgramError> {
		Ok(Self {
			admin: CpiHandle::writable_signer(admin)?,
			beneficiary: CpiHandle::readonly(beneficiary),
			mint: CpiHandle::readonly(mint),
			vesting_state: CpiHandle::writable(vesting_state)?,
			vault: CpiHandle::writable(vault)?,
			associated_token_program: CpiHandle::readonly(associated_token_program),
			system_program: CpiHandle::readonly(system_program),
			token_program: CpiHandle::readonly(token_program),
		})
	}
}

impl<'a> ToCpiAccounts<'a, 8> for InitializeAccounts<'a> {
	fn to_cpi_handles(&self) -> [CpiHandle<'a>; 8] {
		[self.admin, self.beneficiary, self.mint, self.vesting_state, self.vault, self.associated_token_program, self.system_program, self.token_program]
	}
}

/// CPI builder for the `initialize` instruction.
#[derive(Clone, Copy, Debug)]
#[must_use = "the CPI has no effect until invoke or invoke_signed is called"]
pub struct Initialize<'a> {
	/// Validated accounts required by the instruction.
	pub accounts: InitializeAccounts<'a>,

	/// `totalAmount` argument.
	pub total_amount: u64,
	/// `startTs` argument.
	pub start_ts: u64,
	/// `cliffTs` argument.
	pub cliff_ts: u64,
	/// `endTs` argument.
	pub end_ts: u64,
	pub bump: u8,
}

impl<'a> Initialize<'a> {
	/// Builds a `Initialize` CPI instruction.
	#[inline(always)]
	pub const fn new(accounts: InitializeAccounts<'a>, total_amount: u64, start_ts: u64, cliff_ts: u64, end_ts: u64, bump: u8) -> Self {
		Self { accounts, total_amount, start_ts, cliff_ts, end_ts, bump }
	}

	/// Invokes the instruction with no PDA seeds.
	#[inline(always)]
	pub fn invoke(&self, program: &ProgramAccount<'_>) -> ProgramResult {
		self.invoke_signed(program, &[])
	}

	/// Invokes the instruction, signing with the provided PDA seeds.
	#[inline(always)]
	pub fn invoke_signed(
		&self,
		program: &ProgramAccount<'_>,
		signers: &[Signer<'_, '_>],
	) -> ProgramResult {
		let mut data = [0u8; 34];
		data[..1].copy_from_slice(&INITIALIZE_DISCRIMINATOR);
		data[1..9].copy_from_slice(&self.total_amount.to_le_bytes());
		data[9..17].copy_from_slice(&self.start_ts.to_le_bytes());
		data[17..25].copy_from_slice(&self.cliff_ts.to_le_bytes());
		data[25..33].copy_from_slice(&self.end_ts.to_le_bytes());
		data[33..34].copy_from_slice(&self.bump.to_le_bytes());
		let context = CpiContext::new(*program, self.accounts);

		context.invoke_signed(&data, signers)
	}
}

const INITIALIZE_DISCRIMINATOR: [u8; 1] = [0];
