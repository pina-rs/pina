use pina::AccountView;
use pina::CpiContext;
use pina::CpiHandle;
use pina::ProgramResult;
use pina::Signer;

use crate::ProgramAccount;

/// CPI call for the `cancel` instruction.
#[derive(Clone, Copy, Debug)]
#[must_use = "the CPI has no effect until invoke or invoke_signed is called"]
pub struct Cancel<'account> {
	/// CPI account `admin`.
	/// Required privileges: read-only and signer.
	pub admin: &'account AccountView,

	/// CPI account `mint`.
	/// Required privileges: read-only.
	pub mint: &'account AccountView,

	/// CPI account `vestingState`.
	/// Required privileges: writable.
	pub vesting_state: &'account AccountView,

	/// CPI account `vault`.
	/// Required privileges: writable.
	pub vault: &'account AccountView,

	/// CPI account `tokenProgram`.
	/// Required privileges: read-only.
	pub token_program: &'account AccountView,

	/// Instruction arguments encoded and sent as CPI data for `cancel`.
	pub instruction: CancelInstruction,
}

/// Instruction arguments for the `cancel` CPI call.
#[derive(Clone, Copy, Debug, Default)]
pub struct CancelInstruction;

impl CancelInstruction {
	/// Number of bytes in the encoded instruction, including its discriminator.
	pub const LEN: usize = 1;

	/// Encodes the discriminator and instruction arguments for CPI.
	#[inline(always)]
	pub fn to_bytes(&self) -> [u8; 1] {
		let mut data = [0u8; 1];
		data[..1].copy_from_slice(&CANCEL_DISCRIMINATOR);

		data
	}
}

impl<'account> Cancel<'account> {
	/// Invokes the instruction with no PDA seeds.
	#[inline(always)]
	pub fn invoke(&self, program: &ProgramAccount<'_>) -> ProgramResult {
		self.invoke_signed(program, &[])
	}

	/// Invokes the instruction, signing with the provided PDA seeds.
	#[inline(always)]
	pub fn invoke_signed(
		&self,
		program: &ProgramAccount<'_>,
		signers: &[Signer<'_, '_>],
	) -> ProgramResult {
		let accounts: [CpiHandle<'_>; 5] = [
			CpiHandle::readonly_signer(self.admin),
			CpiHandle::readonly(self.mint),
			CpiHandle::writable(self.vesting_state)?,
			CpiHandle::writable(self.vault)?,
			CpiHandle::readonly(self.token_program),
		];
		let data = self.instruction.to_bytes();
		let context = CpiContext::new(*program, accounts);

		context.invoke_signed(&data, signers)
	}
}

const CANCEL_DISCRIMINATOR: [u8; 1] = [2];
