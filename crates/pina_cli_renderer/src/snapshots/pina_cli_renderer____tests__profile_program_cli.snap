use clap::Args;

use crate::context::CliContext;
use crate::context::CliError;
use fixture_client::instructions::AddTag;
use fixture_client::instructions::AddTagInstructionData;
use solana_sdk::pubkey::Pubkey;

#[derive(Debug, Args)]
pub struct AddTagArgs {
	#[arg(long)]
	tag: u64,
	/// The profile's authority. Must sign to prove ownership [default: payer]
	#[arg(long)]
	authority: Option<String>,
	/// The profile PDA account (must already exist and be writable) [default: derived]
	#[arg(long)]
	profile: Option<String>,
}

pub(crate) fn run(context: &CliContext, args: AddTagArgs) -> Result<(), CliError> {
	let authority = match &args.authority {
		Some(value) => CliContext::pubkey("--authority", value)?,
		None => context.payer_pubkey(),
	};
	let profile = match &args.profile {
		Some(value) => CliContext::pubkey("--profile", value)?,
		None => Pubkey::find_program_address(
			&["profile".as_bytes(), authority.as_ref()],
			&context.program_address,
		)
		.0,
	};
	let data = AddTagInstructionData::new(|data| {
		data.tag.set(args.tag);
	})
	.map_err(|_| CliError::InvalidData {
		message: "instruction data rejected the provided arguments".to_string(),
	})?;

	let accounts = AddTag {
		authority: authority,
		profile: profile,
	};

	context.send(accounts.instruction(data))
}

