fn run(cli: Cli) -> Result<(), context::CliError> {
	let program_address = match &cli.program_id {
		Some(value) => CliContext::pubkey("--program-id", value)?,
		None => Pubkey::from_str_const("6oW4PDgWpZGWqAEZNvqnAtQi8GotATsxxjCLYQpZJhHL"),
	};
	let context = CliContext::new(&cli.url, &cli.keypair, program_address, cli.simulate, cli.json)?;

	match cli.command {
		Command::Initialize(args) => commands::initialize::run(&context, args),
		Command::UpdateProfile(args) => commands::update_profile::run(&context, args),
		Command::AddTag(args) => commands::add_tag::run(&context, args),
		Command::RemoveTag(args) => commands::remove_tag::run(&context, args),
		Command::Fetch(command) => fetch::run(&context, command),
	}
}
