use clap::Args;

use crate::context::CliContext;
use crate::context::CliError;
use fixture_client::instructions::Initialize;
use fixture_client::instructions::InitializeInstructionData;
use solana_sdk::pubkey::Pubkey;

#[derive(Debug, Args)]
pub struct InitializeArgs {
	#[arg(long)]
	bump: u8,
	#[arg(long)]
	name: String,
	#[arg(long)]
	bio: String,
	/// The wallet creating the profile. Pays for account creation and becomes the authority whose address seeds the PDA [default: payer]
	#[arg(long)]
	authority: Option<String>,
	/// The profile PDA account (must be empty — not yet created) [default: derived]
	#[arg(long)]
	profile: Option<String>,
}

pub(crate) fn run(context: &CliContext, args: InitializeArgs) -> Result<(), CliError> {
	let authority = match &args.authority {
		Some(value) => CliContext::pubkey("--authority", value)?,
		None => context.payer_pubkey(),
	};
	let profile = match &args.profile {
		Some(value) => CliContext::pubkey("--profile", value)?,
		None => Pubkey::find_program_address(
			&["profile".as_bytes(), authority.as_ref()],
			&context.program_address,
		)
		.0,
	};
	let mut invalid: Option<String> = None;
	let data = InitializeInstructionData::new(|data| {
		data.bump = args.bump;
		if let Err(error) = data.name.try_set(&args.name) {
			invalid = Some(format!("--name: {error}"));
		}
		if let Err(error) = data.bio.try_set(&args.bio) {
			invalid = Some(format!("--bio: {error}"));
		}
	})
	.map_err(|_| CliError::InvalidData {
		message: "instruction data rejected the provided arguments".to_string(),
	})?;
	if let Some(message) = invalid {
		return Err(CliError::InvalidData { message });
	}

	let accounts = Initialize {
		authority: authority,
		profile: profile,
		system_program: Pubkey::from_str_const("11111111111111111111111111111111"),
	};

	context.send(accounts.instruction(data))
}

