use clap::Args;

use crate::context::CliContext;
use crate::context::CliError;
use fixture_client::instructions::Make;
use fixture_client::instructions::MakeInstructionData;
use solana_sdk::pubkey::Pubkey;

#[derive(Debug, Args)]
pub struct MakeArgs {
	#[arg(long)]
	seed: u64,
	#[arg(long)]
	amount_a: u64,
	#[arg(long)]
	amount_b: u64,
	#[arg(long)]
	bump: u8,
	/// The `maker` account [default: payer]
	#[arg(long)]
	maker: Option<String>,
	/// The `mint_a` account
	#[arg(long)]
	mint_a: String,
	/// The `mint_b` account
	#[arg(long)]
	mint_b: String,
	/// The `maker_ata_a` account
	#[arg(long)]
	maker_ata_a: String,
	/// The `escrow` account
	#[arg(long)]
	escrow: String,
	/// The `vault` account
	#[arg(long)]
	vault: String,
	/// The `token_program` account
	#[arg(long)]
	token_program: String,
}

pub(crate) fn run(context: &CliContext, args: MakeArgs) -> Result<(), CliError> {
	let maker = match &args.maker {
		Some(value) => CliContext::pubkey("--maker", value)?,
		None => context.payer_pubkey(),
	};
	let mint_a = CliContext::pubkey("--mint_a", &args.mint_a)?;
	let mint_b = CliContext::pubkey("--mint_b", &args.mint_b)?;
	let maker_ata_a = CliContext::pubkey("--maker_ata_a", &args.maker_ata_a)?;
	let escrow = CliContext::pubkey("--escrow", &args.escrow)?;
	let vault = CliContext::pubkey("--vault", &args.vault)?;
	let token_program = CliContext::pubkey("--token_program", &args.token_program)?;
	let data = MakeInstructionData::new(|data| {
		data.seed.set(args.seed);
		data.amount_a.set(args.amount_a);
		data.amount_b.set(args.amount_b);
		data.bump = args.bump;
	})
	.map_err(|_| CliError::InvalidData {
		message: "instruction data rejected the provided arguments".to_string(),
	})?;

	let accounts = Make {
		maker: maker,
		mint_a: mint_a,
		mint_b: mint_b,
		maker_ata_a: maker_ata_a,
		escrow: escrow,
		vault: vault,
		associated_token_program: Pubkey::from_str_const("ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL"),
		system_program: Pubkey::from_str_const("11111111111111111111111111111111"),
		token_program: token_program,
	};

	context.send(accounts.instruction(data))
}

