//! This code was AUTOGENERATED by `pina_cli_renderer`.
//! Please DO NOT EDIT THIS FILE directly.
//! Regenerate it from the program IDL instead.
#![allow(
	clippy::doc_lazy_continuation,
	clippy::empty_line_after_doc_comments,
	clippy::too_many_arguments
)]

use clap::Args;
use clap::Subcommand;
use serde_json::Value;
use serde_json::json;

use crate::context::CliContext;
use crate::context::CliError;
use fixture_client;
use solana_sdk::pubkey::Pubkey;

#[derive(Debug, Subcommand)]
pub enum Command {

	EscrowState(EscrowStateArgs),
}

#[derive(Debug, Args)]
pub struct EscrowStateArgs {
	/// Account address; overrides PDA derivation.
	#[arg(long)]
	address: Option<String>,
	/// PDA seed `maker`.
	#[arg(long)]
	maker: Option<String>,
	/// PDA seed `seed`.
	#[arg(long)]
	seed: Option<u64>,
}


pub(crate) fn run(context: &CliContext, command: Command) -> Result<(), CliError> {
	match command {
		Command::EscrowState(args) => fetch_escrow_state(context, args),
	}
}

fn fetch_escrow_state(context: &CliContext, args: EscrowStateArgs) -> Result<(), CliError> {
	let address = match &args.address {
		Some(value) => CliContext::pubkey("--address", value)?,
		None => {
				let maker = match &args.maker {
					Some(value) => CliContext::pubkey("--maker", value)?,
					None => return Err(CliError::MissingSeed { account: "escrow-state".to_string(), seed: "--maker".to_string() }),
				};
				let seed = args.seed.ok_or_else(|| CliError::MissingSeed { account: "escrow-state".to_string(), seed: "--seed".to_string() })?;
			let seed_bytes = seed.to_le_bytes();
			let seeds: &[&[u8]] = &["escrow".as_bytes(), maker.as_ref(), seed_bytes.as_ref()];
			Pubkey::find_program_address(seeds, &context.program_address).0
		}
	};
	let data = context.fetch_account(&address)?;
	let value = match fixture_client::accounts::EscrowState::from_bytes(&data) {
		Ok(account) => escrow_state_json(&account),
		Err(error) => return Err(CliError::AccountDecode {
			address: address.to_string(),
			message: error.to_string(),
		}),
	};
	print_value(context.json, "escrow-state", &address, &value);
	Ok(())
}

fn escrow_state_json(account: &fixture_client::accounts::EscrowStateZc) -> Value {
	json!({
		"maker": account.maker.to_string(),
		"mint_a": account.mint_a.to_string(),
		"mint_b": account.mint_b.to_string(),
		"amount_a": account.amount_a.get(),
		"amount_b": account.amount_b.get(),
		"seed": account.seed.get(),
		"bump": account.bump,
	})
}

fn print_value(json_output: bool, name: &str, address: &Pubkey, value: &Value) {
	if json_output {
		println!("{}", serde_json::to_string_pretty(value).unwrap_or_default());
		return;
	}

	println!("{name} {address}");
	if let Some(fields) = value.as_object() {
		for (key, value) in fields {
			println!("  {key}: {value}");
		}
	}
}

