    fn validate_ref(value: &Self) -> Result<(), ::pina::ZeroPodError> {
        <[u8; InstrDisc::BYTES] as ::pina::ZcValidate>::validate_ref(
            &value.discriminator,
        )?;
        <PodU64 as ::pina::ZcValidate>::validate_ref(&value.amount)?;
        Ok(())
