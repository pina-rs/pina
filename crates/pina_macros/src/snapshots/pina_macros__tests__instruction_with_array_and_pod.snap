    fn write_bytes(&self, output: &mut [u8]) {
        ::core::assert!(output.len() == ::core::mem::size_of:: < Self > ());
        output.fill(0);
        let mut offset = 0usize;
        let field_size = ::core::mem::size_of::<[u8; MyInstruction::BYTES]>();
        <[u8; MyInstruction::BYTES] as ::pina::PinaSerialize>::write_bytes(
