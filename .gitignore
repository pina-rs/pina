# Build output. A single recursive rule covers the workspace, the top-level
# `/target`, `programs/`, and every `examples/*/target` directory that nested
# crates create when built from their own manifest.
**/target
/docs/book
**/lints/**/Cargo.lock
**/security/**/Cargo.lock
/.helix
/result
/.direnv
**/rustc-ice-*.txt

# LLVM profile data written by `coverage:all`. Each test binary drops one in
# its crate directory, so a full coverage run would otherwise litter the
# worktree.
*.profraw

# Devenv
.devenv*
devenv.local.nix

**/dist/**

# insta snapshots
*.pending-snap
*.snap.new

