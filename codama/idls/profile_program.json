							],
							"type": {
								"kind": "optionTypeNode",
								"fixed": true,
								"item": {
									"kind": "numberTypeNode",
									"format": "u64",
									"endian": "le"
								},
								"prefix": {
									"kind": "numberTypeNode",
									"format": "u8",
									"endian": "le"
								}
							}
						},
