{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	},
	"include": ["clients/cli/ts/**/src/**/*.ts", "clients/js/**/src/**/*.ts"]
}
